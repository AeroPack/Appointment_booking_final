# Copy to .env and adjust. Compose reads this automatically.

# ---- Database credentials / name (used by both profiles) --------------------
POSTGRES_USER=appointment
POSTGRES_PASSWORD=change_me
POSTGRES_DB=appointment_booking

# ---- LOCAL container (profile: localdb) -------------------------------------
# Host port for the local dev DB. Kept off 5432 to avoid clashing.
DB_PORT=5433

# ---- BOOTSTRAP target (profile: bootstrap) ----------------------------------
# Where the bootstrap job connects. For the LOCAL container use 5433; for the
# EXISTING VPS Postgres use its published port (commonly 5432) and that
# instance's superuser credentials above.
PGHOST=127.0.0.1
PGPORT=5432

# ---- App connection string (for your Node service) --------------------------
# Local:  postgresql://appointment:change_me@localhost:5433/appointment_booking
# VPS:    postgresql://<user>:<pass>@localhost:5432/appointment_booking
DATABASE_URL=postgresql://appointment:change_me@localhost:5433/appointment_booking

# ---- AI Content Extraction (Google Gemini) -----------------------------------
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- WhatsApp provider selection -----------------------------------------------
# 'cloud'    = Meta WhatsApp Cloud API. Required for the booking bot: it is the
#              only provider that can send tappable buttons and the slot list.
# 'bhashsms' = legacy text-only gateway (default until cutover is verified).
WA_PROVIDER=bhashsms

# ---- WhatsApp Cloud API (Meta) --------------------------------------------------
# From Meta dashboard > WhatsApp > API Setup.
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_ACCESS_TOKEN=
# App secret, used to verify the X-Hub-Signature-256 on inbound webhooks.
WA_CLOUD_APP_SECRET=
# Any string you choose; paste the same value into the webhook setup form.
WA_CLOUD_VERIFY_TOKEN=
WA_CLOUD_API_VERSION=v21.0
# Language code of the approved templates, e.g. en or en_US.
WA_CLOUD_TEMPLATE_LANG=en

# ---- WhatsApp (BhashSMS gateway) ----------------------------------------------
# App-level gateway credentials. Per-clinic control is the clinics.whatsapp_enabled flag.
WA_GATEWAY_URL=http://bhashsms.com/api/sendmsgutil.php
WA_GATEWAY_USER=
WA_GATEWAY_PASS=
WA_GATEWAY_SENDER=BUZWAP

# ---- WhatsApp auth/OTP template (separate gateway account) ---------------------
# OTPs go through an approved template: text=<template>, Params=<otp>, stype=auth.
# WA_AUTH_USER/PASS/SENDER fall back to the WA_GATEWAY_* values above when left blank.
WA_AUTH_URL=http://bhashsms.com/api/sendmsgutil.php
WA_AUTH_USER=
WA_AUTH_PASS=
WA_AUTH_SENDER=BUZWAP
WA_AUTH_TEMPLATE=aero_auth

# ---- Internal server-to-server auth -------------------------------------------
INTERNAL_API_KEY=